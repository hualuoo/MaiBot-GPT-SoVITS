{
  "schema_version": 2,
  "required_capabilities": [
    "custom_pages",
    "structured_arguments"
  ],
  "workspace_title": "GPT-SoVITS 语音设置",
  "pages": [
    {
      "id": "setup",
      "title": "语音设置",
      "description": "连接语音服务，选择模型、配置参数与自动语音回复。",
      "placement": "workspace",
      "icon": "settings",
      "mode": "custom",
      "entry": "webui/setup.html",
      "layout": "document",
      "queries": {
        "state": {
          "api": "setup_state",
          "parameters": {}
        },
        "catalog": {
          "api": "setup_catalog",
          "parameters": {
            "root": {
              "type": "string",
              "required": true,
              "max_length": 1024
            }
          }
        },
        "job": {
          "api": "setup_job",
          "parameters": {
            "job_id": {
              "type": "string",
              "required": true,
              "max_length": 64
            }
          }
        },
        "audio": {
          "api": "setup_audio",
          "parameters": {
            "job_id": {
              "type": "string",
              "required": true,
              "max_length": 64
            },
            "offset": {
              "type": "integer",
              "required": true,
              "minimum": 0,
              "maximum": 16777216
            }
          }
        },
        "roles": {
          "api": "setup_roles",
          "parameters": {}
        },
        "check_config": {
          "api": "setup_check_config",
          "parameters": {}
        },
        "ensure_connection": {
          "api": "setup_ensure_connection",
          "parameters": {}
        },
        "llm_tasks": {
          "api": "setup_llm_tasks",
          "parameters": {}
        }
      },
      "actions": {
        "save_api": {
          "api": "setup_save_api",
          "parameters": {
            "base_url": {
              "type": "string",
              "required": true,
              "max_length": 2048
            },
            "timeout": {
              "type": "number",
              "required": true,
              "minimum": 1,
              "maximum": 240
            }
          }
        },
        "test_api": {
          "api": "setup_test_api",
          "parameters": {}
        },
        "save_models": {
          "api": "setup_save_models",
          "parameters": {
            "root": {
              "type": "string",
              "required": true,
              "max_length": 1024
            },
            "base_model": {
              "type": "string",
              "required": true,
              "max_length": 80
            },
            "gpt_weights": {
              "type": "string",
              "required": true,
              "max_length": 1024
            },
            "sovits_weights": {
              "type": "string",
              "required": true,
              "max_length": 1024
            },
            "ref_audio_path": {
              "type": "string",
              "required": true,
              "max_length": 1024
            },
            "prompt_text": {
              "type": "string",
              "required": true,
              "max_length": 4000
            },
            "prompt_lang": {
              "type": "string",
              "required": true,
              "max_length": 32
            },
            "text_lang": {
              "type": "string",
              "required": true,
              "max_length": 32
            },
            "lora_weights": {
              "type": "string",
              "required": true,
              "max_length": 1024
            }
          }
        },
        "start_job": {
          "api": "setup_start_job",
          "parameters": {
            "kind": {
              "type": "string",
              "required": true,
              "max_length": 16,
              "choices": [
                "load_models",
                "synthesize"
              ]
            },
            "text": {
              "type": "string",
              "required": true,
              "max_length": 300
            }
          }
        },
        "cancel_job": {
          "api": "setup_cancel_job",
          "parameters": {
            "job_id": {
              "type": "string",
              "required": true,
              "max_length": 64
            }
          }
        },
        "set_mode": {
          "api": "setup_set_mode",
          "parameters": {
            "mode": {
              "type": "string",
              "required": true,
              "max_length": 16,
              "choices": [
                "original",
                "role"
              ]
            }
          }
        },
        "prepare_role": {
          "api": "setup_prepare_role",
          "parameters": {
            "role_id": {
              "type": "string",
              "required": true,
              "max_length": 240
            },
            "emotion": {
              "type": "string",
              "required": true,
              "max_length": 80
            },
            "emotions": {
              "type": "array",
              "required": true,
              "max_items": 50,
              "items": {
                "type": "string",
                "max_length": 80
              }
            }
          }
        },
        "save_base": {
          "api": "setup_save_base",
          "parameters": {
            "root": {
              "type": "string",
              "required": true,
              "max_length": 1024
            },
            "sovits_weights": {
              "type": "string",
              "required": true,
              "max_length": 1024
            }
          }
        },
        "save_parameters": {
          "api": "setup_save_parameters",
          "parameters": {
            "speed_factor": {
              "type": "number",
              "required": true,
              "minimum": 0.5,
              "maximum": 2
            },
            "top_k": {
              "type": "integer",
              "required": true,
              "minimum": 1,
              "maximum": 100
            },
            "top_p": {
              "type": "number",
              "required": true,
              "minimum": 0.000001,
              "maximum": 1
            },
            "temperature": {
              "type": "number",
              "required": true,
              "minimum": 0.000001,
              "maximum": 2
            },
            "seed": {
              "type": "integer",
              "required": true,
              "minimum": -1,
              "maximum": 2147483647
            },
            "text_split_method": {
              "type": "string",
              "required": true,
              "choices": [
                "cut0",
                "cut1",
                "cut2",
                "cut3",
                "cut4",
                "cut5"
              ],
              "max_length": 4
            },
            "parallel_infer": {
              "type": "boolean",
              "required": true
            },
            "max_text_length": {
              "type": "integer",
              "required": true,
              "minimum": 1,
              "maximum": 2000
            },
            "cooldown_seconds": {
              "type": "number",
              "required": true,
              "minimum": 0,
              "maximum": 3600
            },
            "send_text": {
              "type": "boolean",
              "required": true
            }
          }
        },
        "save_auto_voice": {
          "api": "setup_save_auto_voice",
          "parameters": {
            "enabled": {
              "type": "boolean",
              "required": true
            },
            "frequency_mode": {
              "type": "string",
              "required": true,
              "max_length": 16,
              "choices": [
                "probability",
                "every_n"
              ]
            },
            "probability_percent": {
              "type": "integer",
              "required": true,
              "minimum": 0,
              "maximum": 100
            },
            "every_n": {
              "type": "integer",
              "required": true,
              "minimum": 1,
              "maximum": 1000
            },
            "min_interval_seconds": {
              "type": "number",
              "required": true,
              "minimum": 0,
              "maximum": 3600
            },
            "follow_emotion": {
              "type": "boolean",
              "required": true
            },
            "keep_text": {
              "type": "boolean",
              "required": true
            }
          }
        },
        "save_emotion_judge": {
          "api": "setup_save_emotion_judge",
          "parameters": {
            "llm_emotion": {
              "type": "boolean",
              "required": true
            },
            "llm_task": {
              "type": "string",
              "required": true,
              "max_length": 80
            }
          }
        },
        "test_emotion": {
          "api": "setup_test_emotion",
          "parameters": {
            "text": {
              "type": "string",
              "required": true,
              "max_length": 300
            }
          }
        }
      }
    }
  ]
}
