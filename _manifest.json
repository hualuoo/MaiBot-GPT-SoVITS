{
  "manifest_version": 2,
  "id": "local.gpt-sovits-tts",
  "version": "1.0.0",
  "name": "GPT-SoVITS 语音合成",
  "description": "基于 GPT-SoVITS 的文本转语音插件：CPU/GPU 本地部署，几秒参考音频即可音色克隆，LLM 情感分类自动切换语气，以语音消息回复。",
  "author": {
    "name": "hualuoo",
    "url": "https://github.com/hualuoo"
  },
  "license": "MIT",
  "host_application": {
    "min_version": "1.3.6",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.20.0",
    "max_version": "2.99.99"
  },
  "urls": {"repository": "https://github.com/hualuoo/MaiBot-GPT-SoVITS"},
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]},
  "dependencies": [{"type": "python_package", "name": "aiohttp", "version_spec": ">=3.9,<4"}, {"type": "python_package", "name": "tomlkit", "version_spec": ">=0.13,<1"}],
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/maibot-microphone-chibi-256.png",
      "fallback": "bot",
      "background": "#FFF4E6"
    }
  },
  "capabilities": [
    "send.text",
    "send.custom",
    "llm.generate",
    "llm.get_available_models"
  ]
}
